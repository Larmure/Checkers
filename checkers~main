#!/bin/bash

# -----------------------------------------------------------------------------
# Wrapper script to launch the Checkers application.
# This script abstracts the Maven complexity for the end-user.
#
# Usage: ./checkers [OPTIONS] [ARGUMENTS]
# -----------------------------------------------------------------------------
# Flags explanation:
#   -q : Quiet mode. Suppresses standard Maven build logs
#        so the user only sees the application output.
#   -e : Errors. Displays detailed error messages if the build fails.
#
# Argument handling:
#   "$*" : Collects all arguments passed to this script (e.g., -v -h) and passes
#          them as a SINGLE string to the application.

mvn -q -e exec:java -Dexec.args="$*"